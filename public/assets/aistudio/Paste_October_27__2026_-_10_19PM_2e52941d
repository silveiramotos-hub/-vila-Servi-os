        // WhatsApp Quote Submission
        const industrialQuoteForm = document.getElementById('industrialQuoteForm');
        industrialQuoteForm.addEventListener('submit', (e) => {
            e.preventDefault();

            const service = document.getElementById('quoteService').value;
            const urgency = document.getElementById('quoteUrgency').value;
            const company = document.getElementById('quoteCompany').value;
            const name = document.getElementById('quoteName').value;
            const city = document.getElementById('quoteCity').value;
            const phoneUser = document.getElementById('quotePhone').value;
            const details = document.getElementById('quoteDetails').value;

            const phoneDestination = "5575999150344";

            const message = `*SOLICITAÇÃO DE COTAÇÃO - ÁVILA SERVIÇOS INDUSTRIAIS*%0A%0A` +
                            `🏭 *Empresa:* ${encodeURIComponent(company)}%0A` +
                            `👤 *Contato:* ${encodeURIComponent(name)}%0A` +
                            `📞 *Telefone:* ${encodeURIComponent(phoneUser)}%0A` +
                            `📍 *Localização da Planta:* ${encodeURIComponent(city)}%0A` +
                            `⚙️ *Segmento:* ${encodeURIComponent(service)}%0A` +
                            `⏱️ *Prioridade:* ${encodeURIComponent(urgency)}%0A` +
                            `📝 *Escopo/Detalhes:* ${encodeURIComponent(details || 'Sem detalhes informados')}%0A%0A` +
                            `Gostaria de agendar contato técnico ou receber estimativa de custos. Obrigado!`;

            window.open(`https://wa.me/${phoneDestination}?text=${message}`, '_blank');
        });

        // ----------------------------------------------------
        // HostGator ZIP Generator
        // ----------------------------------------------------
        const modal = document.getElementById('hostgatorModal');
        const openTop = document.getElementById('btnDownloadZipTop');
        const openFooter = document.getElementById('btnDownloadZipFooter');
        const closeModal = document.getElementById('closeModalBtn');
        const triggerDownload = document.getElementById('btnTriggerZipDownload');
        const zipStatus = document.getElementById('zipStatusMsg');

        const showModal = () => modal.classList.remove('hidden');
        const hideModal = () => modal.classList.add('hidden');

        if (openTop) openTop.addEventListener('click', showModal);
        if (openFooter) openFooter.addEventListener('click', showModal);
        if (closeModal) closeModal.addEventListener('click', hideModal);

        modal.addEventListener('click', (e) => {
            if (e.target === modal) hideModal();
        });

        triggerDownload.addEventListener('click', async () => {
            try {
                zipStatus.textContent = "Gerando pacote ZIP para HostGator...";
                zipStatus.classList.remove('hidden');

                const zip = new JSZip();

                // 1. Obter o HTML limpo da página atual
                const htmlContent = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
                zip.file("index.html", htmlContent);

                // 2. Arquivo .htaccess configurado para Apache HostGator
                const htaccessContent = `# Configuração Apache HostGator - Ávila Serviços Industriais
RewriteEngine On

# Forçar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Habilitar Compressão Gzip para performance máxima
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# Cache de Navegador para ativos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Proteção de listagem de diretórios
Options -Indexes
`;
                zip.file(".htaccess", htaccessContent);

                // 3. Arquivo robots.txt
                const robotsContent = `User-agent: *
Allow: /
Sitemap: https://avilaservicos.com.br/sitemap.xml
`;
                zip.file("robots.txt", robotsContent);

                // 4. Guia passo a passo de publicação no cPanel
                const instructionsContent = `=============================================================
GUIA DE INSTALAÇÃO NA HOSTGATOR (cPanel)
Empresa: ÁVILA SERVIÇOS INDUSTRIAIS E USINAGEM LTDA
CNPJ: 21.718.381/0001-19 - Alagoinhas - Bahia
=============================================================

1. Acesse o painel da HostGator (cPanel):
   https://seudominio.com.br/cpanel (ou pelo portal do cliente HostGator)

2. No cPanel, clique em "Gerenciador de Arquivos" (File Manager).

3. Entre na pasta raiz do site:
   public_html

4. No menu superior, clique em "Carregar" (Upload) e selecione este arquivo:
   avila-servicos-hostgator.zip

5. Ao terminar o carregamento (barra verde 100%), volte para a pasta public_html,
   clique com o botão direito no ZIP e selecione "Extract" (Extrair).

6. Verifique se os seguintes arquivos estão diretamente dentro de public_html:
   - index.html
   - .htaccess
   - robots.txt

7. Pronto! Seu site estará online com conexão HTTPS segura, navegação veloz e integração direta para o WhatsApp (75) 99915-0344 e e-mail contato@avilaservicos.com.br.
`;
                zip.file("INSTRUCOES-HOSTGATOR.txt", instructionsContent);

                // Gerar o ZIP e disparar download
                const blob = await zip.generateAsync({ type: "blob" });
                const downloadUrl = URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = downloadUrl;
                a.download = "avila-servicos-hostgator.zip";
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(downloadUrl);

                zipStatus.textContent = "✓ Download iniciado com sucesso!";
            } catch (err) {
                console.error(err);
                zipStatus.textContent = "Erro ao gerar o ZIP. Tente novamente.";
            }
        });
    </script>
